<interface>
	<name>GPU devices</name>
	<description>GPUs from the GPU plugin cache, one index per GPU identity</description>
	<script_path>|path_cacti|/plugins/gpu/ss_gpu.php</script_path>
	<script_function>ss_gpu</script_function>
	<script_server>php</script_server>
	<arg_prepend>|host_id|</arg_prepend>
	<arg_index>index</arg_index>
	<arg_num_indexes>num_indexes</arg_num_indexes>
	<arg_query>query</arg_query>
	<arg_get>get</arg_get>
	<output_delimiter>!</output_delimiter>
	<index_order>gpuIndex:gpuKey</index_order>
	<index_order_type>numeric</index_order_type>
	<index_title_format>|chosen_order_field|</index_title_format>
	<fields>
		<gpuKey>
			<name>Identity key</name>
			<direction>input</direction>
			<query_name>index</query_name>
		</gpuKey>
		<gpuIndex>
			<name>GPU index</name>
			<direction>input</direction>
			<query_name>gpu_index</query_name>
		</gpuIndex>
		<gpuName>
			<name>Product name</name>
			<direction>input</direction>
			<query_name>name</query_name>
		</gpuName>
		<gpuBusId>
			<name>PCI bus ID</name>
			<direction>input</direction>
			<query_name>pci_bus_id</query_name>
		</gpuBusId>
		<util_gpu>
			<name>GPU utilization</name>
			<direction>output</direction>
			<query_name>util_gpu</query_name>
		</util_gpu>
		<util_mem>
			<name>Memory controller utilization</name>
			<direction>output</direction>
			<query_name>util_mem</query_name>
		</util_mem>
		<mem_used>
			<name>Frame buffer memory used</name>
			<direction>output</direction>
			<query_name>mem_used</query_name>
		</mem_used>
		<mem_total>
			<name>Frame buffer memory total</name>
			<direction>output</direction>
			<query_name>mem_total</query_name>
		</mem_total>
		<temp_gpu>
			<name>GPU temperature</name>
			<direction>output</direction>
			<query_name>temp_gpu</query_name>
		</temp_gpu>
		<power>
			<name>Board power draw</name>
			<direction>output</direction>
			<query_name>power</query_name>
		</power>
		<power_limit>
			<name>Board power limit</name>
			<direction>output</direction>
			<query_name>power_limit</query_name>
		</power_limit>
		<clock_sm>
			<name>SM clock</name>
			<direction>output</direction>
			<query_name>clock_sm</query_name>
		</clock_sm>
		<clock_mem>
			<name>Memory clock</name>
			<direction>output</direction>
			<query_name>clock_mem</query_name>
		</clock_mem>
		<ecc_corr>
			<name>Corrected ECC errors since driver load</name>
			<direction>output</direction>
			<query_name>ecc_corr</query_name>
		</ecc_corr>
		<ecc_uncorr>
			<name>Uncorrected ECC errors since driver load</name>
			<direction>output</direction>
			<query_name>ecc_uncorr</query_name>
		</ecc_uncorr>
		<retired_pending>
			<name>Page retirement pending</name>
			<direction>output</direction>
			<query_name>retired_pending</query_name>
		</retired_pending>
		<thr_sw_power_cap>
			<name>Clocks held by the software power cap</name>
			<direction>output</direction>
			<query_name>thr_sw_power_cap</query_name>
		</thr_sw_power_cap>
		<thr_hw_slowdown>
			<name>Hardware slowdown</name>
			<direction>output</direction>
			<query_name>thr_hw_slowdown</query_name>
		</thr_hw_slowdown>
		<thr_sw_thermal>
			<name>Software thermal slowdown</name>
			<direction>output</direction>
			<query_name>thr_sw_thermal</query_name>
		</thr_sw_thermal>
		<thr_hw_thermal>
			<name>Hardware thermal slowdown</name>
			<direction>output</direction>
			<query_name>thr_hw_thermal</query_name>
		</thr_hw_thermal>
		<thr_hw_power_brake>
			<name>Hardware power brake</name>
			<direction>output</direction>
			<query_name>thr_hw_power_brake</query_name>
		</thr_hw_power_brake>
		<age>
			<name>Seconds since the tool took the sample</name>
			<direction>output</direction>
			<query_name>age</query_name>
		</age>
	</fields>
</interface>
