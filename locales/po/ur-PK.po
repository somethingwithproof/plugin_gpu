#: gpu_nodes.php
msgid "That GPU node or GPU does not exist, or is on a device you do not have access to."
msgstr "وہ GPU نوڈ یا GPU موجود نہیں ہے، یا کسی ایسی ڈیوائس پر ہے جس تک آپ کو رسائی حاصل نہیں ہے۔"

#: gpu_nodes.php
msgid "The GPU data query could not be added to the device. Check that the plugin's templates are installed."
msgstr "ڈیوائس میں GPU ڈیٹا کوئری شامل نہیں کی جا سکی۔ تصدیق کریں کہ پلگ ان کے ٹیمپلیٹس انسٹال ہیں۔"

#: gpu_nodes.php
msgid "Device: the node's device was deleted, so the node can only be disabled."
msgstr "ڈیوائس: نوڈ کی ڈیوائس حذف کر دی گئی تھی، اس لیے نوڈ کو صرف غیر فعال کیا جا سکتا ہے۔"

#: gpu_nodes.php
msgid "Device: choose an existing Cacti device."
msgstr "ڈیوائس: کوئی موجودہ Cacti ڈیوائس منتخب کریں۔"

#: gpu_nodes.php
msgid "Device: this device is already a GPU node."
msgstr "ڈیوائس: یہ ڈیوائس پہلے ہی ایک GPU نوڈ ہے۔"

#: gpu_nodes.php
msgid "The GPU node was saved."
msgstr "GPU نوڈ محفوظ کر دیا گیا۔"

#: gpu_nodes.php
msgid "The GPU node could not be saved."
msgstr "GPU نوڈ محفوظ نہیں کیا جا سکا۔"

#: gpu_nodes.php
msgid "The GPU node was removed. Its Cacti device was left in place."
msgstr "GPU نوڈ ہٹا دیا گیا۔ اس کی Cacti ڈیوائس اپنی جگہ برقرار رکھی گئی۔"

#: gpu_nodes.php
msgid "The GPU node was not removed because GPU records belong to it. Disable it instead; GPU records are never deleted."
msgstr "GPU نوڈ نہیں ہٹایا گیا کیونکہ اس سے GPU ریکارڈز منسلک ہیں۔ اس کے بجائے اسے غیر فعال کر دیں؛ GPU ریکارڈز کبھی حذف نہیں کیے جاتے۔"

#: gpu_nodes.php
msgid "The GPU now belongs to the node it was seen at, with its history."
msgstr "GPU اب اپنی تاریخ سمیت اس نوڈ سے منسلک ہے جہاں یہ دیکھا گیا تھا۔"

#: gpu_nodes.php
msgid "The GPU stays with its recorded node."
msgstr "GPU اپنے ریکارڈ شدہ نوڈ کے ساتھ ہی رہتا ہے۔"

#: gpu_nodes.php
msgid "The GPU will leave the data query at the next reindex. Its graphs and RRD files are kept."
msgstr "اگلے ری انڈیکس پر GPU ڈیٹا کوئری سے نکل جائے گا۔ اس کے گرافس اور RRD فائلیں محفوظ رکھی جاتی ہیں۔"

#: gpu_nodes.php
msgid "Only an absent GPU can be removed from the data query."
msgstr "صرف غیر موجود GPU کو ہی ڈیٹا کوئری سے ہٹایا جا سکتا ہے۔"

#: gpu_nodes.php
msgid "Creating a device needs permission to manage Cacti devices."
msgstr "ڈیوائس بنانے کے لیے Cacti ڈیوائسز کے انتظام کی اجازت درکار ہے۔"

#: gpu_nodes.php
msgid "Description: enter up to 150 printable characters."
msgstr "تفصیل: زیادہ سے زیادہ 150 قابلِ پرنٹ حروف درج کریں۔"

#: gpu_nodes.php
msgid "Hostname: enter a host name or IP address."
msgstr "ہوسٹ نام: ہوسٹ نام یا IP پتہ درج کریں۔"

#: gpu_nodes.php
msgid "The GPU Node device template is not installed."
msgstr "GPU Node ڈیوائس ٹیمپلیٹ انسٹال نہیں ہے۔"

#: gpu_nodes.php
msgid "The device was not kept: your account may not see devices it creates. Ask an administrator to create it."
msgstr "ڈیوائس محفوظ نہیں رکھی گئی: ہو سکتا ہے آپ کا اکاؤنٹ اپنی بنائی ہوئی ڈیوائسز نہ دیکھ سکتا ہو۔ منتظم سے اسے بنانے کے لیے کہیں۔"

#: gpu_nodes.php
msgid "The device could not be removed after access was refused. Ask an administrator to remove it."
msgstr "رسائی مسترد ہونے کے بعد ڈیوائس کو ہٹایا نہیں جا سکا۔ منتظم سے اسے ہٹانے کے لیے کہیں۔"

#: gpu_nodes.php
msgid "The device and its GPU node were created. Set the device's SNMP settings on its device page."
msgstr "ڈیوائس اور اس کا GPU نوڈ بنا دیے گئے۔ ڈیوائس کے صفحے پر اس کی SNMP ترتیبات سیٹ کریں۔"

#: gpu_nodes.php
msgid "The device could not be created; see the Cacti log."
msgstr "ڈیوائس نہیں بنائی جا سکی؛ Cacti لاگ دیکھیں۔"

