#: gpu_nodes.php
msgid "Device: the node's device was deleted, so the node can only be disabled."
msgstr "Idivayisi: idivayisi yenodi isusiwe, ngakho inodi ingakhutshazwa kuphela."

#: gpu_nodes.php
msgid "Device: choose an existing Cacti device."
msgstr "Idivayisi: khetha idivayisi ye-Cacti ekhona."

