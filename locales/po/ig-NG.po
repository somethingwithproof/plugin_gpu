msgid "The GPU stays with its recorded node."
msgstr "GPU ahụ na-anọgide na nọọdụ edere ya na ya."

#: gpu_nodes.php
msgid "The GPU will leave the data query at the next reindex. Its graphs and RRD files are kept."
msgstr "GPU ahụ ga-ahapụ ajụjụ data na ndepụta ọzọ. A na-edebe eserese ya na faịlụ RRD ya."

#: gpu_nodes.php
msgid "Only an absent GPU can be removed from the data query."
msgstr "Naanị GPU na-anọghị nwere ike iwepụ site na ajụjụ data."

