#: gpu_nodes.php
msgid "The device and its GPU node were created. Set the device's SNMP settings on its device page."
msgstr "E mepụtara ngwaọrụ ahụ na nọọdụ GPU ya. Hazie ntọala SNMP nke ngwaọrụ ahụ na peeji ngwaọrụ ya."

#: gpu_nodes.php
msgid "The device could not be created; see the Cacti log."
msgstr "Enweghị ike ịmepụta ngwaọrụ ahụ; lee ndekọ Cacti."

