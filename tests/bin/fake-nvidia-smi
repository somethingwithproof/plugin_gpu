# A stand-in for /usr/bin/nvidia-smi in the end-to-end test, run by snmpd
# through the documented extend lines (docs/node-setup.md). snmpd starts it
# with an empty environment, so its state lives in fixed files under
# /var/lib/gpu-e2e, which tests/bin/e2e.php writes:
#
#   expected-query  the metrics --query-gpu value the plugin's model asks for
#   current.metrics fixture lines, with @NOW@ for the sample time
#   current.names   fixture lines for the names entry
#   current.status  optional: the metrics query exits with this status and
#                   an NVML error on stderr, as a broken driver does
#   current.delay   optional: the metrics query sleeps this many seconds
#                   first, as a hung driver does
#
# The status and delay apply to the metrics query only. snmpd caches the
# names entry for 300 seconds, so a failure there would outlast the test
# step that set it; the plugin reads the metrics entry first, so a failure
# of both commands fails the collection there.
#
# It accepts only the two documented argument vectors, so a drift between
# the documentation and the plugin's field list fails the test.

set -eu

dir=/var/lib/gpu-e2e

if [ "$#" -eq 2 ] && [ "$1" = "--query-gpu=$(cat "$dir/expected-query")" ] && [ "$2" = '--format=csv,noheader,nounits' ]; then
	if [ -s "$dir/current.delay" ]; then
		sleep "$(cat "$dir/current.delay")"
	fi
	if [ -s "$dir/current.status" ]; then
		echo 'Failed to initialize NVML: Driver/library version mismatch' >&2
		exit "$(cat "$dir/current.status")"
	fi
	now=$(date -u '+%Y/%m/%d %H:%M:%S.000')
	sed "s#@NOW@#$now#" "$dir/current.metrics"
elif [ "$#" -eq 2 ] && [ "$1" = '--query-gpu=uuid,name' ] && [ "$2" = '--format=csv,noheader' ]; then
	cat "$dir/current.names"
else
	echo "fake nvidia-smi: unexpected arguments: $*" >&2
	exit 2
fi
