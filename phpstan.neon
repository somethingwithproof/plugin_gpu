# Static analysis of the plugin classes against a Cacti core checkout.
#   CACTI_PATH=/path/to/cacti phpstan analyse -c phpstan.neon
# Core is scanned for symbols only.
parameters:
    level: 9
    phpVersion: 80200
    paths:
        - lib
        - setup.php
        - include/operator.php
        - include/unbooted-uninstall.php
        - gpu_nodes.php
        - gpu_operator.php
        - gpu_health.php
        - gpu_inventory.php
        - poller_gpu.php
        - ss_gpu.php
    scanDirectories:
        - %env.CACTI_PATH%/lib
        - %env.CACTI_PATH%/include
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    excludePaths:
        analyseAndScan:
            - %env.CACTI_PATH%/include/vendor/*
            - %env.CACTI_PATH%/include/fa/*
            - %env.CACTI_PATH%/include/js/*
            - %env.CACTI_PATH%/include/themes/*
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # Cacti pages and CLI scripts chdir() to the Cacti root before
        # including core files, so the relative paths resolve only at runtime.
        -
            identifiers: [include.fileNotFound, includeOnce.fileNotFound]
            paths: [gpu_*.php]
        -
            identifier: requireOnce.fileNotFound
            path: gpu_operator.php
        -
            identifier: require.fileNotFound
            path: poller_gpu.php
        # $config comes from core's cli_check.php.
        -
            identifier: variable.undefined
            path: poller_gpu.php
        # csrf-magic is in include/vendor, which is not scanned.
        -
            message: '#^Function csrf_check not found\.$#'
            path: gpu_operator.php
